{
  "manifest_version": 3,
  "name": "Meet Attendance",
  "version": "1.2.0",
  "description": "Runs inside your online class (Google Meet, Zoom, Teams, Webex), reads the participant list, marks attendance, and syncs sessions to your web dashboard.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://*.zoom.us/*",
    "https://*.zoom.com/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://*.webex.com/*",
    "https://whereby.com/*",
    "https://*.whereby.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://*.zoom.us/*",
        "https://*.zoom.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://*.webex.com/*",
        "https://whereby.com/*",
        "https://*.whereby.com/*"
      ],
      "js": ["default-students.js", "core.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Meet Attendance",
    "default_popup": "popup.html"
  }
}
